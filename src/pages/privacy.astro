---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy | Donoghue Payroll Services" description="How Donoghue Payroll Services uses the information you send us.">
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight">Privacy</h1>
    <p class="mt-4 leading-relaxed text-brand-muted">
      If you contact us through this website, we use the details you provide only to respond to your enquiry about payroll, contracts of employment or company handbooks.
    </p>
    <p class="mt-4 leading-relaxed text-brand-muted">
      Donoghue Payroll Services Ltd is registered in Scotland with company number SC410315.
    </p>
    <p class="mt-4 leading-relaxed text-brand-muted">
      Enquiries are handled by Donoghue Payroll Services. You can email
      <a class="text-brand underline" href="mailto:payroll@donoghuepayrollservices.com">payroll@donoghuepayrollservices.com</a>
      if you would like us to delete a message you have sent.
    </p>
  </main>
  <Footer />
</Layout>
