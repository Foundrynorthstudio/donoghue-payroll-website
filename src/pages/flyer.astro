---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import officeTeam from '../assets/images/office-team.jpg';

const payrollPoints = [
  'Employee payments, tax compliance and reporting',
  'Accuracy and attention to detail at all times',
  'Pensions and benefits management',
  'Leave and absence management',
  'Employee and employer self-service portal',
  'CIS and year end rebates',
  "P11D's — all benefits (BIK) now to be processed through payroll from April 2027",
  'Compliance with regulatory updates',
] as const;
---

<Layout
  title="Flyer | Donoghue Payroll Services"
  description="Payroll, contracts and company handbooks — done properly. Payments, tax, pensions, leave, P11D's, year end rebates and a self-service portal."
>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden bg-brand-mint-2">
      <Image
        src={officeTeam}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-[center_30%] opacity-30"
        widths={[960, 1440]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-brand/15 mix-blend-multiply" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl px-5 py-16 md:py-20">
        <p class="heading-caps text-xs font-semibold text-brand">Donoghue Payroll Services</p>
        <h1 class="mt-4 font-sans text-4xl font-bold leading-tight tracking-tight text-brand-ink sm:text-5xl">
          Payroll, contracts and company handbooks — done properly.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-muted">
          We cover all aspects of employee payments, tax compliance and reporting. Written contracts and company handbooks are a legal requirement — we can help.
        </p>
        <div class="mt-8 grid gap-4">
          <article class="rounded-2xl border border-brand-line bg-white/90 p-6 shadow-sm">
            <p class="heading-caps text-xs font-semibold text-brand">Payroll</p>
            <h2 class="mt-2 text-xl font-bold text-brand-ink">Pay your people correctly, every time.</h2>
            <p class="mt-2 leading-relaxed text-brand-muted">Payments, tax, pensions, leave, P11D's, year end rebates and a self-service portal.</p>
          </article>
          <article class="rounded-2xl border border-brand-line bg-white/90 p-6 shadow-sm">
            <p class="heading-caps text-xs font-semibold text-brand">Contracts of employment</p>
            <h2 class="mt-2 text-xl font-bold text-brand-ink">A legal requirement — we can help.</h2>
            <p class="mt-2 leading-relaxed text-brand-muted">Written terms for each employee, meeting the legal standard and HR best practice.</p>
          </article>
          <article class="rounded-2xl border border-brand-line bg-white/90 p-6 shadow-sm">
            <p class="heading-caps text-xs font-semibold text-brand">Company handbooks</p>
            <h2 class="mt-2 text-xl font-bold text-brand-ink">Policies tailored to your business.</h2>
            <p class="mt-2 leading-relaxed text-brand-muted">Disciplinary, health and safety, equality, statutory payments — written for your company.</p>
          </article>
        </div>
        <div class="mt-8 rounded-2xl bg-brand p-6 text-white">
          <p class="heading-caps text-xs font-semibold tracking-wider">Mobile 07862 098770</p>
          <p class="mt-2 text-lg font-bold">
            <a class="hover:underline" href="mailto:payroll@donoghuepayrollservices.com">payroll@donoghuepayrollservices.com</a>
          </p>
          <p class="mt-2 text-sm text-white/90">Company registration number SC410315</p>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-3xl px-5 py-16 md:py-20">
        <p class="heading-caps text-xs font-semibold text-brand">Payroll services</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-brand-ink">Everything you need to pay your staff correctly.</h2>
        <ul class="mt-8 divide-y border-y border-brand-line">
          {payrollPoints.map((point) => (
            <li class="py-4 leading-relaxed text-brand-ink">{point}</li>
          ))}
        </ul>
        <div class="mt-10 rounded-2xl bg-brand-mint p-8">
          <p class="heading-caps text-xs font-semibold text-brand">Contracts of employment &amp; company handbooks</p>
          <h3 class="mt-3 text-2xl font-bold text-brand-ink">This is a legal requirement — we can help.</h3>
          <p class="mt-3 leading-relaxed text-brand-muted">
            A written Statement of Employment Particulars is required by UK law. A full contract and a bespoke company handbook keep terms and policies in one place.
          </p>
        </div>
        <div class="mt-8">
          <a href="/#contact" class="inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark">
            Request a quote
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
