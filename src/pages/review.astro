---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Review | Donoghue Payroll Services"
  description="Internal review of the emailer and A5 flyer."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Header />
  <main class="bg-brand-mint-2">
    <div class="mx-auto max-w-6xl px-5 py-12 md:py-16">
      <p class="heading-caps text-xs font-semibold text-brand">Internal review</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-ink sm:text-4xl">Emailer and A5 flyer</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-brand-muted">
        This page is a temporary place to check the email layout and the print flyer in the browser. It is not linked from the public site.
      </p>

      <section id="emailer" class="mt-12">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-brand-ink">HTML emailer</h2>
            <p class="mt-1 text-sm text-brand-muted">How the email will look when opened. Scroll inside the frame to read it all.</p>
          </div>
          <a
            href="/marketing/emailer.html"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-brand-line bg-white px-4 py-2 text-sm font-semibold text-brand-ink hover:border-brand"
          >
            Open emailer in a new tab
          </a>
        </div>
        <div class="mt-5 overflow-x-auto rounded-2xl border border-brand-line bg-[#f4faf1] p-4 shadow-sm">
          <iframe
            title="Donoghue Payroll Services emailer"
            src="/marketing/emailer.html"
            class="mx-auto block h-[2200px] w-full min-w-[320px] max-w-[620px] bg-white"
          ></iframe>
        </div>
      </section>

      <section id="flyer" class="mt-16">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-brand-ink">A5 flyer</h2>
            <p class="mt-1 text-sm text-brand-muted">Two-sided PDF. Use the download button if your browser does not show it below.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href="/marketing/flyer-a5.html"
              target="_blank"
              rel="noreferrer"
              class="rounded-full border border-brand-line bg-white px-4 py-2 text-sm font-semibold text-brand-ink hover:border-brand"
            >
              Open flyer layout
            </a>
            <a
              href="/marketing/donoghue-payroll-a5-flyer.pdf"
              download
              class="rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-dark"
            >
              Download PDF
            </a>
          </div>
        </div>
        <div class="mt-5 overflow-hidden rounded-2xl border border-brand-line bg-white shadow-sm">
          <iframe
            title="Donoghue Payroll Services A5 flyer PDF"
            src="/marketing/donoghue-payroll-a5-flyer.pdf"
            class="h-[900px] w-full md:h-[1100px]"
          ></iframe>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
