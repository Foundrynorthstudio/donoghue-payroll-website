---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Thank you | Donoghue Payroll Services" description="Thanks for getting in touch with Donoghue Payroll Services.">
  <Header />
  <main class="mx-auto max-w-2xl px-5 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight">Thank you</h1>
    <p class="mt-4 leading-relaxed text-brand-muted">
      We have received your message and will come back to you with more information and a fee quote.
    </p>
    <a href="/" class="mt-8 inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark">
      Back to the homepage
    </a>
  </main>
  <Footer />
</Layout>
