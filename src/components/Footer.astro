---
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-line bg-brand-mint-2">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-3">
    <div>
      <img src="/logo.png" alt="Donoghue Payroll Services" class="h-12 w-auto" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-brand-muted">
        Payroll, contracts of employment and company handbooks for businesses, from the team at Donoghue &amp; Co.
      </p>
    </div>
    <div>
      <h2 class="heading-caps text-xs font-semibold text-brand">Get in touch</h2>
      <address class="mt-3 not-italic text-sm leading-7 text-brand-muted">
        <a class="block hover:text-brand" href="mailto:payroll@donoghue-co.com">payroll@donoghue-co.com</a>
        <a class="block hover:text-brand" href="tel:+441324411809">01324 411809</a>
        <a class="block hover:text-brand" href="tel:+441413541584">0141 354 1584</a>
        <span class="mt-3 block">19a Wellside Place, Falkirk, FK1 5RL</span>
        <span class="block">272 Bath Street, Glasgow, G2 4JR</span>
      </address>
    </div>
    <div>
      <h2 class="heading-caps text-xs font-semibold text-brand">Useful links</h2>
      <ul class="mt-3 space-y-2 text-sm text-brand-muted">
        <li><a class="hover:text-brand" href="/#payroll">Payroll services</a></li>
        <li><a class="hover:text-brand" href="/#contracts">Contracts &amp; handbooks</a></li>
        <li><a class="hover:text-brand" href="https://donoghue-co.com" rel="noreferrer">Donoghue &amp; Co</a></li>
        <li><a class="hover:text-brand" href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-line">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-brand-muted">
      &copy; {year} Donoghue Payroll Services. All rights reserved.
    </p>
  </div>
</footer>
